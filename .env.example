# Core
AUTOPILOT_ENV=development
ARTIFACTS_DIR=artifacts
CHANNEL_NICHE=AI tools, technology and useful websites
DEFAULT_VIDEO_FORMAT=short
ENABLE_UPLOADS=false
UPLOAD_PRIVACY_STATUS=private

# OpenAI (optional until AI generation is enabled)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Voice
EDGE_TTS_VOICE=en-US-GuyNeural

# Rendering
FFMPEG_BINARY=ffmpeg

# YouTube OAuth - keep real files OUTSIDE this repository
YOUTUBE_CLIENT_SECRETS_FILE=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# Scheduler (local timezone)
SCHEDULE_TIMEZONE=Asia/Kolkata
SCHEDULE_HOUR=18
SCHEDULE_MINUTE=0
