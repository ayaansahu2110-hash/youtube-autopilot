# Core
AUTOPILOT_ENV=development
ARTIFACTS_DIR=artifacts
STATE_FILE=state/history.json
CHANNEL_NICHE=AI tools, technology and useful websites
DEFAULT_VIDEO_FORMAT=short
TOPIC_QUERIES=AI tools,artificial intelligence,technology,useful websites,productivity apps
DISCOVERY_REGIONS=US,IN,GB
MIN_RESEARCH_SOURCES=2

# Publishing safety
ENABLE_UPLOADS=false
UPLOAD_PRIVACY_STATUS=private
ALLOW_PUBLIC_UPLOADS=false
YOUTUBE_CATEGORY_ID=28
YOUTUBE_MADE_FOR_KIDS=false

# OpenAI API (separate from a ChatGPT subscription)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Free stock video provider
PEXELS_API_KEY=
MAX_VISUAL_CLIPS_SHORT=6
MAX_VISUAL_CLIPS_LONG=16
VISUAL_CLIP_SECONDS=5

# Voice / rendering
EDGE_TTS_VOICE=en-US-GuyNeural
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# YouTube OAuth - keep real files OUTSIDE this repository
YOUTUBE_CLIENT_SECRETS_FILE=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# Schedule
SCHEDULE_TIMEZONE=Asia/Kolkata
SCHEDULE_HOUR=18
SCHEDULE_MINUTE=0
LONGFORM_ENABLED=true
LONGFORM_DAYS=mon,wed,fri
ANALYTICS_LOOKBACK_DAYS=28
